# Configuration par machine — AUCUN SECRET ICI.
# Copier en config/machine.env et ajuster.

# Profil Compose : mac | linux-gpu
PENNY_PROFILE=mac

# Inférence : native sur Mac (hors Docker), en conteneur sur linux-gpu
# Port 11435 sur Mac : le 11434 reste à l'Ollama du compte de développement
PENNY_OLLAMA_URL=http://127.0.0.1:11435

# Profil mac uniquement : binaires lancés au démarrage par launchd
# (scripts/mac/install-services.sh). Ils ne doivent pas être modifiables par penny.
PENNY_ORB_BIN=/opt/homebrew/bin/orb
PENNY_OLLAMA_BIN=/opt/homebrew/bin/ollama

# Emplacement des données (hors du dépôt)
PENNY_DATA_DIR=/Users/penny/penny-data

# Fournisseur de secrets : macos-keychain | linux-vault (à choisir)
PENNY_SECRETS_BACKEND=macos-keychain
