# Configuration de Penny pour le compte penny — AUCUN SECRET ICI.
# Installée par scripts/mac/deploy-penny.sh dans /Users/penny/.config/penny/penny.env

PENNY_DATA_DIR=/Users/penny/penny-data
PENNY_OLLAMA_URL=http://127.0.0.1:11435

# Modèles locaux (tags figés). Le modèle de génération doit tenir en mémoire à côté du reste.
PENNY_LLM_MODEL=qwen3:8b
PENNY_EMBED_MODEL=bge-m3

# Accès OneDrive en lecture seule par rclone
PENNY_RCLONE_BIN=/opt/homebrew/bin/rclone
PENNY_RCLONE_REMOTE=penny-onedrive
PENNY_RCLONE_CONFIG=/Users/penny/.config/penny/rclone.conf
# Mot de passe de la configuration rclone chiffrée, lu dans le trousseau de penny.
# Laisser vide pour le saisir à chaque lancement.
#PENNY_RCLONE_PASSWORD_COMMAND=security find-generic-password -a penny -s penny-rclone -w

# Fichiers plus gros ignorés (Mo)
PENNY_MAX_FILE_MB=50
